# =============================================================================
# SmartParkingSystem — .gitignore
# Anything that is generated locally, environment-specific, or carries
# credentials must NOT be committed.
# =============================================================================

# ---------- Build outputs ----------
build/
cmake-build-*/
out/
bin/

CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CMakePresets.json
cmake_install.cmake
_deps/

# ---------- Compiled artifacts ----------
*.exe
*.dll
*.lib
*.obj
*.o
*.a
*.so
*.exp
*.ilk
*.pdb
*.pdb
*.idb
*.res

# ---------- IDE / editor ----------
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.sln
*.vcxproj
*.vcxproj.*
*.code-workspace
*.swp
.DS_Store

# ---------- Conan ----------
conan_toolchain.cmake
conanbuildinfo.*
conanbuild*.bat
conanrun*.bat
deactivate_conan*.bat
conandeps_legacy.cmake
cmakedeps_macros.cmake
asio*.cmake
asioTargets.cmake

# ---------- Runtime / local config with real credentials ----------
config/db_config.json
config/*.local.json

# ---------- Logs / scratch ----------
logs/
*.log
test_output.txt

# ---------- OS junk ----------
Thumbs.db
Desktop.ini

# ---------- Editor / tooling state ----------
.claude/
CLAUDE.md
.claude_settings/
